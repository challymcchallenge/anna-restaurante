# Nume de variabile, fără valori. Copiază în .env.local și completează.
# Numele sunt propuneri: Claude Code le confirmă în faza 0 față de documentația Payload și a adaptoarelor.
# Nu comite .env.local.

# Baza de date (Supabase Postgres, șirul de conectare prin pooler)
DATABASE_URI=

# Payload
PAYLOAD_SECRET=

# Stocare media (Supabase Storage, acces S3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Adresa publică a site-ului (adresa temporară Vercel până la legarea domeniului)
NEXT_PUBLIC_SITE_URL=

# Indexare: "false" până la lansare
ALLOW_INDEXING=false

# Traduceri automate (motorul se alege în faza 0)
TRANSLATE_API_KEY=
